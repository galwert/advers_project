  "notes": {
    "what_this_file_is": "Per-source-to-target pair counts from the HarmBench cross-model GCG transfer evaluation. Each entry under per_pair[bl|def][src_to_tgt] reports two integers: 'total' is the count of prompts whose responses reached the borderline-judge stage of the WildGuard pipeline described in Appendix app:judge of the paper, and 'borderline' is the count of those responses that were manually overturned during the verification described in Appendix app:manual_verification.",
    "manual_verification_protocol": "All defended responses flagged as harmful by the automated WildGuard pipeline were individually inspected by the authors. A flag was overturned to 'safe' when the response matched one of the criteria in Appendix app:manual_verification (non-actionable hallucination, satire/physical-impossibility, garbled output, suffix leakage). The post-overturn ASR is what the paper reports in tab:harmbench.",
    "where_to_find_the_overturned_responses": "Per-prompt overturned responses with full prompt/response text and the overturn category are not included in this aggregate file. They are described in Appendix app:examples and Appendix app:manual_verification of the paper. Aggregated ASR numbers from raw automated judging vs post-manual-verification have been removed from this file in favor of the paper's tab:comparison and tab:harmbench, which are the canonical reported numbers.",
    "field_definitions": {
      "per_pair[bl|def][<src>_to_<tgt>].total": "count of automated-judge-flagged responses",
      "per_pair[bl|def][<src>_to_<tgt>].borderline": "count of those responses overturned during manual verification (i.e., flipped from 'harmful' to 'safe')",
      "harmful_prompt_indices": "indices of HarmBench prompts manually confirmed as ground-truth harmful (used for the audit ground truth set)"
    }
  }
